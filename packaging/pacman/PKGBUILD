# Maintainer: Christopher Patrick Fair <christopherpatrickfair@gmail.com>
pkgname=newscid
pkgver=1.3.0
pkgrel=1
pkgdesc="Modern Chess Information Database (Scid vs. PC Rewrite)"
arch=('x86_64')
url="https://github.com/chrisfair/newscid"
license=('GPL-3.0-or-later')
depends=('gtk3' 'webkit2gtk-4.1' 'hicolor-icon-theme')
makedepends=('go' 'nodejs' 'npm' 'git' 'python-pillow')
optdepends=(
    'stockfish: strong default UCI chess engine'
    'fruit: legacy UCI chess engine'
    'scid: legacy database tools (tcscid)'
)
source=("${pkgname}-${pkgver}.tar.gz:https:://github.com/chrisfair/newscid/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums('61e7f5bfa560af7a5d79139541cd251de808e0f469393685aa33fe4a1bdb93d4')


prepare() {
    cd "${srcdir}/${pkgname}/frontend"
    npm install
}

build() {
    cd "${srcdir}/${pkgname}"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -modcacherw"

    make build
}

package() {
    cd "${srcdir}/${pkgname}"
    make install DESTDIR="${pkgdir}" PREFIX="/usr"
}
